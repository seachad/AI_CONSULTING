    "madurez": {
      "type": "object",
      "description": "Esquema 0.6. Resumen de un diagnóstico de madurez (T15, documento 11 §5). null en un nivel significa que hay preguntas sin responder que bloquean el cálculo.",
      "required": ["id", "fecha_corte", "nivel_global", "dimensiones"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^EM-\\d{4}-\\d{2}(-\\d+)?$" },
        "fecha_corte": { "$ref": "#/$defs/fecha" },
        "ciclo": { "$ref": "#/$defs/texto_o_nulo", "description": "C1, C5 o seguimiento." },
        "modalidad": { "enum": ["autodiagnostico", "verificada", "independiente", null], "description": "El autodiagnóstico no se usa en el panel del consejo (11 §4.1)." },
        "version_cuestionario": { "$ref": "#/$defs/texto_o_nulo" },
        "verificador": { "$ref": "#/$defs/texto_o_nulo" },
        "organo_aprobacion": { "$ref": "#/$defs/texto_o_nulo" },
        "fecha_aprobacion": { "$ref": "#/$defs/fecha_o_nula" },
        "nivel_global": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "nivel_minimo": { "type": ["integer", "null"], "minimum": 0, "maximum": 5, "description": "Nivel garantizado cuando el global no puede fijarse." },
        "media": { "type": ["number", "null"], "description": "Media ponderada con dos decimales (11 §5.3)." },
        "tope": { "type": ["integer", "null"], "description": "min(D1, D6) + 1." },
        "tope_aplicado": { "type": ["boolean", "null"] },
        "limitante": { "type": "array", "items": { "enum": ["D1", "D6"] } },
        "validez": { "enum": ["auto", "pend", "ok", null], "description": "auto: autodiagnóstico; pend: verificación independiente incompleta (11 §4.6); ok: verificada." },
        "declaracion_posible": { "type": ["boolean", "null"], "description": "Declaración de aplicación de SEVEN-G posible (11 §7.3)." },
        "dimensiones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "nivel"],
            "additionalProperties": false,
            "properties": {
              "dimension": { "type": "string", "pattern": "^D[1-7]$" },
              "nombre": { "$ref": "#/$defs/texto_o_nulo" },
              "nivel": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
              "nivel_minimo": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
              "avance": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Porcentaje de avance hacia el nivel siguiente (11 §5.2)." },
              "bloqueantes": { "type": "array", "items": { "type": "string", "pattern": "^D[1-7]\\.\\d{2}$" } }
            }
          }
        },
        "fuente": { "$ref": "#/$defs/texto_o_nulo", "description": "T15." },
        "exportado": { "$ref": "#/$defs/fecha_o_nula" },
        "incorporado": { "$ref": "#/$defs/fecha_o_nula" }
      }
    },
    "recomendacion": {
      "type": "object",
      "required": ["id", "texto", "estado"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^REC-\\d{4}-\\d{3}$" },
        "fecha": { "$ref": "#/$defs/fecha_o_nula" },
        "texto": { "type": "string" },
        "destinatario": { "type": "string" },
        "estado": { "enum": ["abierta", "en_curso", "cerrada", "descartada"] },
        "evidencia": { "$ref": "#/$defs/texto_o_nulo" },
        "iniciativas": { "type": "array", "items": { "$ref": "#/$defs/id_iniciativa" } }
      }
    }
  }
}
