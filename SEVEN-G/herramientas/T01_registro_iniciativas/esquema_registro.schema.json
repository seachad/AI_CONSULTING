        "riesgo_tipo": { "type": "string", "pattern": "^RT-[A-Z]{3}-\\d{2}$" },
        "probabilidad": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "impacto": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "nivel_inherente": { "$ref": "#/$defs/nivel_riesgo_o_nulo" },
        "nivel_residual": { "$ref": "#/$defs/nivel_riesgo_o_nulo" },
        "respuesta": { "enum": ["evitar", "mitigar", "transferir", "aceptar", null] },
        "responsable": { "$ref": "#/$defs/id_persona_o_nula" },
        "controles": { "type": "string" },
        "fecha_alta": { "$ref": "#/$defs/fecha_o_nula", "description": "Esquema 0.4. Fecha de identificación." },
        "eje_impacto": { "enum": ["economico", "personas", "regulatorio", "operativo", "reputacional", null], "description": "Esquema 0.4. Eje que determina el impacto (el mayor de los cinco, 33 §4.2). Con impacto 5 en personas o regulatorio, el riesgo se acepta como Alto como mínimo (33 §4.3, regla 2)." },
        "eficacia_controles": { "enum": ["eficaz", "parcial", "ineficaz", "no_probado", null], "description": "Esquema 0.4. 33 §5.3: eficaz reduce hasta 2 niveles; parcialmente eficaz, 1; ineficaz o no probado, ninguno en el residual verificado." },
        "probabilidad_residual": { "type": ["integer", "null"], "minimum": 1, "maximum": 5, "description": "Esquema 0.4." },
        "impacto_residual": { "type": ["integer", "null"], "minimum": 1, "maximum": 5, "description": "Esquema 0.4." },
        "tipo_residual": { "enum": ["objetivo", "verificado", null], "description": "Esquema 0.4. Objetivo: con los controles previstos (G3, G4). Verificado: con la eficacia de los controles probada (G5, R6) (33 §5.1)." },
        "contingencia": { "$ref": "#/$defs/texto_o_nulo", "description": "Esquema 0.4. Disparador, acciones y quién la activa. Obligatoria en todo riesgo Alto o Crítico en tratamiento (33 §6)." },
        "estado": { "enum": ["identificado", "en_tratamiento", "aceptado", "materializado", "cerrado", null], "description": "Esquema 0.4." },
        "tendencia": { "enum": ["sube", "estable", "baja", null], "description": "Esquema 0.4." },
        "proxima_revision": { "$ref": "#/$defs/fecha_o_nula", "description": "Esquema 0.4. Según la frecuencia de 33 §7.3." },
        "aceptacion": {
          "description": "Esquema 0.4. Aceptación del riesgo residual por el órgano de su nivel (33 §7.1): Bajo, responsable de producto; Medio, patrocinador; Alto, comité de IA; Crítico, solo el consejo o su comisión delegada. null = sin aceptar.",
          "oneOf": [{ "type": "null" }, {
            "type": "object",
            "required": ["organo", "fecha"],
            "additionalProperties": false,
            "properties": {
              "organo": { "enum": ["producto", "patrocinador", "comite_ia", "consejo"] },
              "persona": { "$ref": "#/$defs/id_persona_o_nula" },
              "fecha": { "$ref": "#/$defs/fecha" },
              "vigencia": { "$ref": "#/$defs/fecha_o_nula", "description": "Hasta la siguiente revisión de continuidad o el cambio que la invalide." },
              "referencia": { "$ref": "#/$defs/texto_o_nulo", "description": "Acta, decisión de gate o registro." }
            }
          }]
        }
      }
    },
